# ---- Build stage: type-check and bundle the app ----
FROM node:26.10.0-alpine AS build
WORKDIR /app

COPY package*.json ./
RUN npm ci

COPY . .
# The generated build script runs vue-tsc first, so type errors fail the build.
RUN npm run build

# ---- Serve stage: just nginx and the static files, no Node at all ----
FROM nginx:stable-alpine
COPY nginx.conf /etc/nginx/conf.d/default.conf
COPY --from=build /app/dist /usr/share/nginx/html
EXPOSE 80